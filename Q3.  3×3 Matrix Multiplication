#include <iostream>
#include <string>
using namespace std;

void getValue(int m[3][3], string name) {
    cout << "Enter " << name << " (3x3):" << endl;
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++) {
            cout << "  [" << i << "][" << j << "]: ";
            cin >> m[i][j];
        }
}

void computeAxA(int A[3][3], int B[3][3], int R[3][3]) {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++) R[i][j] = 0;   // initialize

    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            for (int k = 0; k < 3; k++)
                R[i][j] += A[i][k] * B[k][j];       // dot product
}

void printArray(int m[3][3], string name) {
    cout << name << ":" << endl;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) cout << m[i][j] << "\t";
        cout << endl;
    }
}

int main() {
    int A[3][3], B[3][3], R[3][3];
    getValue(A, "Matrix A");
    getValue(B, "Matrix B");
    computeAxA(A, B, R);
    printArray(A, "A");  printArray(B, "B");  printArray(R, "A x B");
    return 0;
}
