#include <iostream>
#include <cmath>
using namespace std;

// Returns population standard deviation of array x with n elements
double stdev(double x[], int n) {
    // Step 1: mean
    double sum = 0;
    for (int i = 0; i < n; i++) sum += x[i];
    double mean = sum / n;

    // Step 2: sum of squared differences
    double sqDiff = 0;
    for (int i = 0; i < n; i++)
        sqDiff += (x[i] - mean) * (x[i] - mean);

    // Step 3: sqrt(variance)
    return sqrt(sqDiff / n);
}

int main() {
    double data[] = {2, 4, 4, 4, 5, 5, 7, 9};
    cout << "Std Dev: " << stdev(data, 8) << endl;  // 2.0
    return 0;
}
